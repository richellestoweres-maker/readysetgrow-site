rules_version = '2';

/*
 * Ready Set Grow, Firestore security rules
 * ------------------------------------------------------------------
 * The rule that matters most, stated once so it is impossible to miss:
 *
 *   A child's profile, milestones, logs and support lenses are readable
 *   only by the parent account that owns them. There is no path in this
 *   file that lets one account read another account's children, and
 *   there never should be.
 *
 * Community content is deliberately kept somewhere else entirely, at the
 * top level, written against a username rather than a child. Nothing a
 * parent posts can reach back into a child's record, and nothing about a
 * child can leak sideways into a public room. That separation is
 * structural rather than a promise.
 *
 * Everything not named below is denied. Firestore denies by default, and
 * the final block says so out loud for whoever reads this next.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAuthor() {
      return signedIn() && request.resource.data.authorUid == request.auth.uid;
    }

    function ownsExisting() {
      return signedIn() && resource.data.authorUid == request.auth.uid;
    }

    /* ---------------------------------------------------------------
     * THE PARENT, AND EVERY CHILD UNDERNEATH THEM
     * One account, one subtree, nobody else. The nested match is what
     * covers children, their logs and their milestones, because rules
     * do not cascade on their own.
     * --------------------------------------------------------------- */
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    /* ---------------------------------------------------------------
     * USERNAMES
     * One document per taken username, so two parents cannot claim the
     * same one. Readable so the signup screen can check availability,
     * and claimable only for yourself.
     * --------------------------------------------------------------- */
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && username.size() >= 3
        && username.size() <= 20;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    /* ---------------------------------------------------------------
     * WHO IS ALLOWED TO APPROVE THINGS
     *
     * One document per moderator, holding nothing. Its existence is the
     * whole permission. Kept as documents rather than hardcoded uids so
     * a second moderator can be added from the console without anybody
     * redeploying these rules at two in the morning.
     *
     * Nobody can write this collection from the app. It is edited in the
     * Firebase console only, which is the point: an account that could
     * make itself a moderator is not a moderation system.
     * --------------------------------------------------------------- */
    function isModerator() {
      return signedIn()
        && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    match /moderators/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    /* ---------------------------------------------------------------
     * THE SHARED FEED
     *
     * NOTHING IS PUBLIC UNTIL A PERSON APPROVES IT. That is the rule
     * this whole block exists to enforce, and it is enforced here rather
     * than in the app, because rules are the only place a promise about
     * who can see what is actually kept.
     *
     * A new post is created with status 'pending' and the rules refuse
     * any other value on create, so an account cannot publish itself by
     * sending a different field. A pending post is readable by its own
     * author and by a moderator, and by nobody else. Only a moderator
     * can move it to 'live', and only a moderator can move it to
     * 'removed'.
     *
     * A post carries a username and never a child id, a birthday, or a
     * name. That is the structural half of the promise that a child's
     * record never becomes community content.
     * --------------------------------------------------------------- */
    match /feed/{postId} {
      allow read: if signedIn() && (
        resource.data.status == 'live'
        || resource.data.authorUid == request.auth.uid
        || isModerator()
      );

      allow create: if isAuthor()
        && request.resource.data.status == 'pending'
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && !('childId' in request.resource.data)
        && !('birthday' in request.resource.data)
        && !('childName' in request.resource.data);

      /* A moderator decides what is live. An author may fix their own
         wording while it is still waiting, and may not touch the status
         while doing it. */
      allow update: if isModerator()
        || (ownsExisting()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.body.size() <= 4000);

      allow delete: if ownsExisting() || isModerator();

      /* One document per person per post, so nobody can overwrite
         everybody else's reactions by writing a map. */
      match /reactions/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid)
          && (request.method == 'delete' || request.resource.data.r is string);
      }
    }

    /* ---------------------------------------------------------------
     * COMMUNITY
     * Any signed in parent can read a room. You may only write as
     * yourself, you may only edit or delete your own, and a post may
     * not carry a child id, which is the structural half of the promise
     * that child records never become community content.
     * --------------------------------------------------------------- */
    match /community/{roomId}/posts/{postId} {
      allow read: if signedIn();

      allow create: if isAuthor()
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && !('childId' in request.resource.data)
        && !('birthday' in request.resource.data);

      allow update: if ownsExisting()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.body.size() <= 4000;

      allow delete: if ownsExisting();

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if isAuthor()
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && !('childId' in request.resource.data);
        allow update: if ownsExisting()
          && request.resource.data.authorUid == resource.data.authorUid;
        allow delete: if ownsExisting();
      }
    }

    /* ---------------------------------------------------------------
     * REPORTS
     * Reports go in and nothing comes out. A person who reports a post
     * must not be able to read other people's reports, and must not be
     * able to edit their own after the fact.
     * --------------------------------------------------------------- */
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    /* ---------------------------------------------------------------
     * EVERYTHING ELSE
     * Firestore already denies anything not explicitly allowed. This is
     * here so that is obvious rather than assumed.
     * --------------------------------------------------------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
